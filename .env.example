# ТАКТ — переменные окружения.
# Сейчас сайт полностью статический и НИ ОДНА из этих переменных не используется:
# файл нужен на тот момент, когда к форме заявки подключат серверную часть.
# Реальные значения сюда не пишутся никогда — они живут в панели хостинга.

# Куда уходит заявка с формы «Запросить внедрение»
FORM_ENDPOINT=https://api.example.com/leads
FORM_API_KEY=замените_на_ключ_из_панели_хостинга

# Почтовый сервис для уведомления менеджера
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=замените_на_пароль_из_панели_хостинга
LEAD_NOTIFY_TO=sales@example.com

# Защита формы от спама (серверная проверка, дополнительно к honeypot в разметке)
TURNSTILE_SECRET=замените_на_секрет_капчи
RATE_LIMIT_PER_HOUR=20

# Источники данных реальной диспетчерской — на демо не используются
GPS_FEED_URL=
CATENARY_FEED_URL=
